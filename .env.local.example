# OpenAIP API
OPENAIP_API_KEY=your_openaip_api_key_here

# MapTiler (for glyphs/fonts and ground basemap)
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
# Optional MapTiler vector basemap style. Default is outdoor-v2 to mirror OpenAIP's vector ground stack.
NEXT_PUBLIC_MAPTILER_BASE_STYLE=outdoor-v2

# Test pilot auth (Supabase email/password)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported for older Supabase projects.

# Account sync storage (Neon through Vercel Marketplace)
POSTGRES_URL=
# DATABASE_URL is also supported if your Neon integration exposes that instead.
DATABASE_URL=

# NOTAM provider
# south-africa-manual is the launch-safe default. Use south-africa-live only after
# SACAA/ATNS or an authorized provider grants API access. Use faa for future FAA rollout.
NOTAM_PROVIDER=south-africa-manual
SOUTH_AFRICA_NOTAM_SOURCE_URL=https://file2fly.atns.co.za/aes/login.jsp
SOUTH_AFRICA_NOTAM_API_URL=
SOUTH_AFRICA_NOTAM_API_KEY=
SOUTH_AFRICA_NOTAM_API_AUTH_HEADER=Authorization
SOUTH_AFRICA_NOTAM_API_AUTH_SCHEME=Bearer

# FAA NOTAM API (server-side only; future international rollout)
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
