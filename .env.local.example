# OpenAIP API
OPENAIP_API_KEY=your_openaip_api_key_here

# MapTiler (for glyphs/fonts)
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Supabase account sync (public browser keys only)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase account persistence (server-only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# NOTAM provider
NOTAM_PROVIDER=south-africa-manual

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
